# Copy this file to .env and fill in your values

# Admin password for the teacher dashboard
ADMIN_KEY=changeme

# A long random string for signing session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Google Sheets spreadsheet ID (from the URL: docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SPREADSHEET_ID=

# Path to the service account JSON (used to write to Google Sheets)
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json

# Path to the OAuth 2.0 Web Client JSON (used for student Google sign-in)
GOOGLE_OAUTH_CLIENT_JSON=credentials/oauth_client.json

# Course name — becomes the worksheet tab name in the spreadsheet
COURSE_NAME=OOP

# ---------------------------------------------------------------------------
# Tunnel — choose one mode
# ---------------------------------------------------------------------------

# TUNNEL_MODE=cloudflare  (recommended — reliable, no iOS issues)
# CLOUDFLARE_PUBLIC_URL=https://attendance.vylabs.uk
# CLOUDFLARE_TUNNEL_NAME=vylabs-hp   # name given during: cloudflared tunnel create

# TUNNEL_MODE=ngrok  (default fallback)
# NGROK_AUTH_TOKEN=    # from https://dashboard.ngrok.com
# NGROK_DOMAIN=        # your free static ngrok domain
TUNNEL_MODE=ngrok
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=
